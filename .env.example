# ================================
#  DocQA — environment template
#  Setup:  cp .env.example .env   then fill in the blanks
# ================================

# ---- Database ----
# Local Docker default (see docker-compose.yml). Swap for your Neon URL in prod.
DATABASE_URL="postgresql://docqa:docqa_dev_password@localhost:5432/docqa"

# ---- Auth.js (NextAuth v5) ----
# Generate with:  openssl rand -base64 32
AUTH_SECRET=""

# ---- AI provider — added in Phase 4 ----
# LLM_API_KEY=""

# ---- Upstash Redis — added in Phase 6 ----
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# -- Google Gemini (embeddings + chat) --
GOOGLE_GENERATIVE_AI_API_KEY=""

# Background job queue (Upstash QStash).
# Locally, set QSTASH_DEV=true and leave the rest blank: the SDK downloads and
# runs a QStash server on your machine, so no public tunnel or real keys needed.
# In production, fill in the three values from the Upstash QStash console and
# do not set QSTASH_DEV at all.
QSTASH_DEV=true
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Optional. Overrides the URL QStash calls back into. Defaults to the Vercel
# deployment URL in production and http://localhost:3000 locally.
APP_URL=
