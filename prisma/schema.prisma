// DocQA data model, see https://pris.ly/d/prisma-schema
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----Enums-----

enum DocumentStatus {
  PROCESSING
  READY
  FAILED
}

enum MessageRole {
  USER
  ASSISTANT
}

// -----Models-----

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspaces Workspace[]
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents Document[]
  messages  ChatMessage[]

  @@index([userId])
}

model Document {
  id          String         @id @default(cuid())
  filename    String
  status      DocumentStatus @default(PROCESSING)
  workspaceId String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  chunks    Chunk[]

  @@index([workspaceId])
}

model Chunk {
  id         String   @id @default(cuid())
  content    String
  chunkIndex Int
  documentId String
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // pgvector column. Prisma cannot model the `vector` type natively, so we
  // declare it as Unsupported and manage its SQL via a raw migration.
  // The HNSW index on this column lives in raw SQL (see the add_chunk_embedding
  // migration). Prisma does not track indexes on Unsupported columns, so when
  // running `prisma migrate dev` in future, discard any generated "DROP INDEX
  // Chunk_embedding_idx" line: the index is intentional.
  embedding Unsupported("vector(768)")?

  @@unique([documentId, chunkIndex])
  @@index([documentId])
}

model ChatMessage {
  id          String      @id @default(cuid())
  role        MessageRole
  content     String
  workspaceId String
  createdAt   DateTime    @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}
